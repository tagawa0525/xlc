import hashlib
import re
import struct
import sys
from pathlib import Path
NAME = re.compile(b'(event|enabled) ([^\\x00]+?\\.rs)(?::([0-9]+))?')
MAX_TEXT = 4096
MAX_DISTANCE = 256
SHT_NOBITS = 8
SHF_ALLOC = 2

class Elf:

    def __init__(self, data: bytes):
        if data[:4] != b'\x7fELF' or data[4] != 2 or data[5] != 1:
            raise ValueError('ELF64 のリトルエンディアンでない')
        shoff, = struct.unpack_from('<Q', data, 40)
        shentsize, shnum, shstrndx = struct.unpack_from('<HHH', data, 58)
        headers = [struct.unpack_from('<IIQQQQ', data, shoff + i * shentsize) for i in range(shnum)]
        names = headers[shstrndx][4]
        self.sections = {}
        for name, kind, flags, addr, offset, size in headers:
            label = data[names + name:data.index(b'\x00', names + name)].decode()
            if kind != SHT_NOBITS:
                self.sections[label] = (flags, addr, offset, size)
        self.loaded = [(addr, offset, size) for flags, addr, offset, size in self.sections.values() if flags & SHF_ALLOC and size]

    def file_offset(self, addr: int, size: int) -> int | None:
        for base, offset, length in self.loaded:
            if base <= addr and addr + size <= base + length:
                return offset + addr - base
        return None

def normalize(data: bytes, unnamed_events: bool=False) -> tuple[bytes, dict[str, int]]:
    elf = Elf(data)
    if '.data.rel.ro' not in elf.sections:
        raise ValueError('.data.rel.ro が無い（位置の情報の置き場が変わった）')
    _, _, relro, relro_size = elf.sections['.data.rel.ro']
    out = bytearray(data)

    def text(slot: int) -> tuple[bytes, int] | None:
        ptr, length = struct.unpack_from('<QQ', data, slot)
        if not 0 < length <= MAX_TEXT:
            return None
        at = elf.file_offset(ptr, length)
        if at is None:
            return None
        return (data[at:at + length], at)

    def location(slot: int) -> bool:
        if slot + 24 > end:
            return False
        ptr, length = struct.unpack_from('<QQ', data, slot)
        at = elf.file_offset(ptr, length + 1)
        line, column = struct.unpack_from('<II', data, slot + 16)
        return at is not None and data[at + length] == 0 and (line > 0) and (column > 0)
    counts = {'location': 0, 'metadata': 0, 'enabled': 0}
    end = relro + relro_size
    first = relro + -relro % 8
    files = {}
    names = []
    for slot in range(first, end - 15, 8):
        found = text(slot)
        if found is None:
            continue
        body, at = found
        match = NAME.fullmatch(body)
        if match is not None:
            if slot - 8 >= first:
                names.append((slot, match, at))
        elif body.endswith(b'.rs'):
            files[slot] = body
    distances = set()
    for slot, match, at in names:
        kind, path, digits = match.groups()
        tag, line = struct.unpack_from('<II', data, slot - 8)
        if tag != 1:
            raise ValueError(f'{match.group(0)!r} の直前が Some(行) でない（Metadata のレイアウトが変わった）')
        if digits is not None:
            if kind == b'event' and path.startswith(b'crates/') and (not unnamed_events):
                raise ValueError(f'{match.group(0)!r}: tracing のイベントのマクロを名前なしで呼んでいる。xlc_log のマクロを使う')
            if line != int(digits):
                raise ValueError(f'{match.group(0)!r} の行と Metadata の line {line} が違う')
            start, stop = match.span(3)
            out[at + start:at + stop] = b'0' * (stop - start)
            if kind == b'enabled':
                counts['enabled'] += 1
        near = [other - slot for other in range(slot + 8, slot + MAX_DISTANCE + 8, 8) if files.get(other) == path]
        if not near:
            raise ValueError(f'{match.group(0)!r} の Metadata にファイルの &str が見つからない')
        distances.add(near[0])
    if len(distances) != 1:
        raise ValueError(f'Metadata の名前からファイルまでの距離が 1 つに決まらない: {sorted(distances)}（イベントが無いか、レイアウトが変わった）')
    distance, = distances
    for slot in files:
        name = slot - distance
        if name - 8 < first or text(name) is None:
            continue
        tag, line = struct.unpack_from('<II', data, name - 8)
        if tag != 1 or line == 0:
            continue
        if location(slot):
            raise ValueError(f'0x{slot:x} の &str が Location にも Metadata のファイル名にも当たる（レイアウトが変わったか、偶然の一致）')
        struct.pack_into('<I', out, name - 4, 0)
        counts['metadata'] += 1
        files[slot] = None
    for slot, body in files.items():
        if body is not None and location(slot):
            struct.pack_into('<II', out, slot + 16, 0, 0)
            counts['location'] += 1
    if counts['location'] == 0:
        raise ValueError('Location が見つからない（Location のレイアウトが変わった）')
    return (bytes(out), counts)

def form(data: bytes, unnamed_events: bool=False) -> str:
    return hashlib.md5(normalize(data, unnamed_events)[0]).hexdigest()

def main(argv: list[str]) -> None:
    if len(argv) != 2:
        raise SystemExit('usage: python3 scripts/normalize_binary.py <binary> <form>')
    src, dst = (Path(argv[0]), Path(argv[1]))
    copy, counts = normalize(src.read_bytes())
    dst.parent.mkdir(parents=True, exist_ok=True)
    dst.write_text(hashlib.md5(copy).hexdigest() + '\n', encoding='utf-8')
    print(f'{dst}: ' + ' '.join((f'{k}={v}' for k, v in counts.items())))
if __name__ == '__main__':
    main(sys.argv[1:])
