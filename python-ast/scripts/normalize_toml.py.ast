import hashlib
import json
import sys
from pathlib import Path
import tomllib

def normalize(text: str) -> str:
    values = tomllib.loads(text)
    return json.dumps(values, ensure_ascii=False, indent=1, allow_nan=False) + '\n'

def input_md5(path: Path) -> str:
    data = path.read_bytes()
    if path.suffix == '.toml':
        data = normalize(data.decode('utf-8')).encode('utf-8')
    return hashlib.md5(data).hexdigest()

def main(argv: list[str]) -> None:
    if len(argv) != 2:
        raise SystemExit('usage: python3 scripts/normalize_toml.py <source.toml> <output>')
    src, dst = (Path(argv[0]), Path(argv[1]))
    text = normalize(src.read_text(encoding='utf-8'))
    dst.parent.mkdir(parents=True, exist_ok=True)
    dst.write_text(text, encoding='utf-8')
if __name__ == '__main__':
    main(sys.argv[1:])
