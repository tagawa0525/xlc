import hashlib
import json
import re
import sys
from pathlib import Path
import msgpack
NUCLIDES = ['U-235', 'U-238', 'Pu-239', 'Xe-135', 'Sm-149']
BURNUP_TOLERANCE = 1e-09
VOLUME_TOLERANCE = 1e-06

def openmc_name(name: str) -> str:
    m = re.fullmatch('([A-Z][a-z]?)-(\\d+)(m(\\d*))?', name)
    if m is None:
        raise SystemExit(f'unexpected nuclide name {name}')
    symbol, mass, isomer, level = m.groups()
    return f'{symbol}{mass}' + (f'_m{level or 1}' if isomer else '')

def relative(ours: float, theirs: float) -> float | None:
    return None if theirs == 0.0 else ours / theirs - 1.0

def summarize(xlc: dict, omc: dict) -> dict:
    if xlc['format'] != 'xlc-depletion-history' or omc['format'] != 'openmc-depletion':
        raise SystemExit('unexpected formats')
    ours = {openmc_name(n) for n in xlc['transportable']}
    theirs = set(omc['transportable'])
    if ours != theirs:
        raise SystemExit(f'transported nuclides differ: xlc only {sorted(ours - theirs)}, OpenMC only {sorted(theirs - ours)}')
    burnup = [p['burnup'] for p in xlc['points']]
    if len(burnup) != len(omc['burnup']) or any((abs(a - b) > BURNUP_TOLERANCE * max(b, 1.0) for a, b in zip(burnup, omc['burnup']))):
        raise SystemExit(f"burnup points differ: {burnup} vs {omc['burnup']}")
    regions, rings = (xlc['regions'], omc['rings'])
    if len(regions) != len(rings):
        raise SystemExit(f'{len(regions)} xlc regions for {len(rings)} OpenMC rings')
    if len(rings) > 1 and [r['material'] for r in regions] != [r['name'] for r in rings]:
        raise SystemExit(f"rings differ: xlc {[r['material'] for r in regions]}, OpenMC {[r['name'] for r in rings]}")
    for r, ring in zip(regions, rings):
        if abs(r['volume'] - ring['volume']) > VOLUME_TOLERANCE * ring['volume']:
            raise SystemExit(f"{r['material']}: volume {r['volume']} vs {ring['volume']}")
    index = {name: i for i, name in enumerate(xlc['nuclides'])}
    total = sum((r['volume'] for r in regions))

    def pin(values) -> float:
        return sum((v * r['volume'] for v, r in zip(values, regions))) / total
    first = (xlc['points'][0]['k_inf'] - omc['k'][0]) * 100000.0
    k = []
    for i, point in enumerate(xlc['points']):
        diff = (point['k_inf'] - omc['k'][i]) * 100000.0
        k.append({'xlc': point['k_inf'], 'openmc': omc['k'][i], 'openmc_std_pcm': omc['k-std'][i] * 100000.0, 'diff_pcm': diff, 'change_pcm': diff - first})
    density = {}
    for name in NUCLIDES:
        series = []
        for i, point in enumerate(xlc['points']):
            ours_pin = pin([point['densities'][r][index[name]] for r in range(len(regions))])
            theirs_pin = pin([ring['densities'][openmc_name(name)][i] for ring in rings])
            series.append(relative(ours_pin, theirs_pin))
        density[name] = series
    last = len(burnup) - 1
    by_ring = [{name: relative(xlc['points'][last]['densities'][r][index[name]], ring['densities'][openmc_name(name)][last]) for name in NUCLIDES} for r, ring in enumerate(rings)]
    transport = omc['transport-seconds']
    seconds = {'xlc': {**xlc['seconds'], 'solves': xlc['solves']}, 'openmc': {'transport': sum(transport), 'fastest': min(transport), 'slowest': max(transport), 'solves': len(transport), 'cram': sum(omc['cram-seconds']), 'total': omc['total-seconds']}}
    return {'burnup': burnup, 'transported': len(ours), 'seconds': seconds, 'k': k, 'pin': density, 'rings': by_ring}

def percent(x: float | None) -> str:
    return '–' if x is None else f'{x * 100:+.2f}'

def report(summary: dict) -> list[str]:
    if 'inputs' not in summary:
        raise SystemExit('the JSON has no inputs; rerun the stage')
    lines = ['inputs: ' + ', '.join((f"{i['path']} {i['md5'][:8]}" for i in summary['inputs'])), f"輸送する核種: 両方で同じ {summary['transported']} 核種", '燃焼度 (MWd/kg) | k xlc | k OpenMC | 差 (pcm) | 0 からの変化 (pcm)']
    for b, k in zip(summary['burnup'], summary['k']):
        lines.append(f"{b:g} | {k['xlc']:.6f} | {k['openmc']:.6f} ± {k['openmc_std_pcm'] / 100000.0:.6f} | {k['diff_pcm']:+.0f} ± {k['openmc_std_pcm']:.0f} | {k['change_pcm']:+.0f}")
    lines.append('ピン全体の数密度の相対差 (%): 燃焼度 | ' + ' | '.join(NUCLIDES))
    for i, b in enumerate(summary['burnup']):
        lines.append(f'{b:g} | ' + ' | '.join((percent(summary['pin'][n][i]) for n in NUCLIDES)))
    x, o = (summary['seconds']['xlc'], summary['seconds']['openmc'])
    lines.append(f"時間 xlc（輸送 {x['solves']} 回）: 自己遮蔽 {x['shielding']:.1f} 秒、MOC {x['moc']:.1f} 秒、反応率 {x['rates']:.2f} 秒、燃焼行列 {x['matrix']:.2f} 秒、CRAM {x['cram']:.2f} 秒")
    lines.append(f"時間 OpenMC（輸送 {o['solves']} 回）: 全体 {o['total']:.0f} 秒、輸送 {o['transport']:.0f} 秒（1 回 {o['fastest']:.0f}〜{o['slowest']:.0f} 秒）、CRAM {o['cram']:.1f} 秒")
    if len(summary['rings']) > 1:
        lines.append('最後の点のリングごとの相対差 (%): リング | ' + ' | '.join(NUCLIDES))
        for r, ring in enumerate(summary['rings']):
            lines.append(f'{r} | ' + ' | '.join((percent(ring[n]) for n in NUCLIDES)))
    return lines

def main() -> None:
    args = sys.argv[1:]
    if len(args) == 2 and args[0] == '--report':
        print('\n'.join(report(json.loads(Path(args[1]).read_text()))))
    elif len(args) == 4 and args[0] == '--json':
        files = [Path(args[2]), Path(args[3])]
        xlc, omc = (msgpack.unpackb(f.read_bytes()) for f in files)
        summary = {'format': 'xlc-compare-depletion', 'inputs': [{'path': str(f), 'md5': hashlib.md5(f.read_bytes()).hexdigest()} for f in files], **summarize(xlc, omc)}
        Path(args[1]).write_text(json.dumps(summary, indent=1) + '\n')
        print('\n'.join(report(summary)))
    else:
        raise SystemExit(__doc__)
if __name__ == '__main__':
    main()
