import hashlib
import itertools
import json
import math
import sys
from pathlib import Path
import msgpack
import numpy as np
sys.path.insert(0, str(Path(__file__).resolve().parent))
from compare_branch_cross_terms import table_grid
from compare_burnup_interpolation import k_inf, unvector, vector
TRANSFORMS = {'linear': lambda x: x, 'sqrt': math.sqrt}

def axis_transforms(table: dict) -> list:
    out = []
    for a in table['axes']:
        if a['name'] == 'burnup':
            continue
        name = a.get('transform')
        if name not in TRANSFORMS:
            raise SystemExit(f"{a['name']}: the axis needs a transform of {sorted(TRANSFORMS)}, not {name}")
        out.append(TRANSFORMS[name])
    return out

def summarize(table: dict) -> dict:
    transforms = axis_transforms(table)
    if any(('nominal' not in a for a in table['axes'] if a['name'] != 'burnup')):
        raise SystemExit('the table needs the nominal value of every state axis')
    nominal = {a['name']: a['nominal'] for a in table['axes'] if a['name'] != 'burnup'}
    grid_of = table_grid('table', table, nominal)
    burnup, names, points = (grid_of['burnup'], grid_of['names'], grid_of['points'])
    burnups = burnup if burnup is not None else [None]
    per_point = grid_of['per_point']
    indices = list(itertools.product(*[range(len(p)) for p in points]))
    flat = {index: n for n, index in enumerate(indices)}
    vectors = []
    truths = []
    for b in range(len(burnups)):
        chunk = table['states'][b * per_point:(b + 1) * per_point]
        vectors.append([vector(s) for s in chunk])
        truths.append([(s, k_inf(s)) for s in chunk])
    centers = []
    gaps = {}
    for a, name in enumerate(names):
        g = [transforms[a](x) for x in points[a]]
        for i in range(1, len(g) - 1):
            w = (g[i] - g[i - 1]) / (g[i + 1] - g[i - 1])
            out = []
            for b in range(len(burnups)):
                worst = None
                for index in indices:
                    if index[a] != i:
                        continue
                    low = flat[index[:a] + (i - 1,) + index[a + 1:]]
                    high = flat[index[:a] + (i + 1,) + index[a + 1:]]
                    state, k = truths[b][flat[index]]
                    rebuilt = unvector((1 - w) * vectors[b][low] + w * vectors[b][high], state)
                    rho = (1 / k - 1 / k_inf(rebuilt)) * 100000.0
                    if worst is None or abs(rho) > abs(worst[0]):
                        worst = (rho, index)
                out.append({'burnup': burnups[b], 'max_abs_pcm': abs(worst[0]), 'worst_pcm': worst[0], 'worst': {n: points[k][worst[1][k]] for k, n in enumerate(names)}})
            centers.append({'axis': name, 'point': points[a][i], 'neighbours': [points[a][i - 1], points[a][i + 1]], 'weight': w, 'points': out})
            h1, h2 = (g[i] - g[i - 1], g[i + 1] - g[i])
            for left, h in ((i - 1, h1), (i, h2)):
                factor = h * h / (4 * h1 * h2)
                gaps.setdefault((a, left), []).append({'center': points[a][i], 'factor': factor, 'max_abs_pcm': [p['max_abs_pcm'] * factor for p in out]})
    intervals = [{'axis': names[a], 'interval': [points[a][left], points[a][left + 1]], 'from': sources, 'max_abs_pcm': [max((s['max_abs_pcm'][b] for s in sources)) for b in range(len(burnups))]} for (a, left), sources in sorted(gaps.items())]
    return {'format': 'xlc-compare-grid-interpolation', 'burnup': burnup, 'axes': {n: {'points': p, 'transform': a['transform']} for n, p, a in zip(names, points, [a for a in table['axes'] if a['name'] != 'burnup'], strict=True)}, 'table_k_max_abs_pcm': float(np.max([abs(1 / s['k_inf'] - 1 / k) * 100000.0 for row in truths for s, k in row])), 'centers': centers, 'intervals': intervals}

def report(summary: dict) -> list[str]:
    if 'inputs' not in summary:
        raise SystemExit('the JSON has no inputs; rerun the comparison')
    lines = ['inputs: ' + ', '.join((f"{i['path']} {i['md5'][:8]}" for i in summary['inputs'])), f"k∞ の解き直しとテーブルの k_inf の差の最大 {summary['table_k_max_abs_pcm']:.4f} pcm", '格子点を両隣から内挿した |Δρ| の最大（pcm。燃焼度の点ごと）:']
    for c in summary['centers']:
        values = '、'.join((f"{p['worst_pcm']:+.2f}（{p['worst']}）" for p in c['points']))
        lines.append(f"  {c['axis']} {c['point']:g}（{c['neighbours'][0]:g} と {c['neighbours'][1]:g}、重み {c['weight']:.3f}）: {values}")
    lines.append('区間の中点の見込み（pcm。燃焼度の点ごと。測定でない）:')
    for i in summary['intervals']:
        sources = '、'.join((f"{s['center']:g} から × {s['factor']:.3f} で " + '/'.join((f'{v:.2f}' for v in s['max_abs_pcm'])) for s in i['from']))
        lines.append(f"  {i['axis']} {i['interval'][0]:g}〜{i['interval'][1]:g}: {sources}")
    return lines

def main() -> None:
    args = sys.argv[1:]
    if len(args) == 2 and args[0] == '--report':
        print('\n'.join(report(json.loads(Path(args[1]).read_text()))))
    elif len(args) == 3 and args[0] == '--json':
        path = Path(args[2])
        data = path.read_bytes()
        summary = summarize(msgpack.unpackb(data))
        summary['inputs'] = [{'path': str(path), 'md5': hashlib.md5(data).hexdigest()}]
        Path(args[1]).write_text(json.dumps(summary, indent=1, ensure_ascii=False) + '\n')
        print('\n'.join(report(summary)))
    else:
        raise SystemExit(__doc__)
if __name__ == '__main__':
    main()
