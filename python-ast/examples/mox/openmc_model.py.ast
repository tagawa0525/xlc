import os
import sys
from pathlib import Path
import msgpack
import numpy as np
import openmc
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from openmc_common import STORED, effective_xs, eigenvalue_settings, fuel_tallies, group_filter, material
from openmc_input import input_path, read_input
from openmc_run import RUN_KEYS, model_run_extract, write_k
SCORES = ['total', 'elastic', 'fission', 'capture']
PITCH = 1.26
PELLET = 0.41
CLAD_OUTER = 0.475
TEMPERATURE = 600.0
FUEL = {'MOX-1': {'U235': 5.105e-05, 'U238': 0.02037, 'Pu238': 4.669e-05, 'Pu239': 0.001465, 'Pu240': 0.0005691, 'Pu241': 0.0002713, 'Pu242': 0.0001413, 'Am241': 3.028e-05, 'O16': 0.04588}, 'MOX-2': {'U235': 5.118e-05, 'U238': 0.02042, 'Pu238': 2.714e-05, 'Pu239': 0.001972, 'Pu240': 0.0004256, 'Pu241': 3.577e-05, 'Pu242': 1.234e-05, 'Am241': 1.406e-05, 'O16': 0.04588}}
ZIRCONIUM = {f'Zr{a}': 0.0388 * f / 100 for a, f in {90: 51.45, 91: 11.22, 92: 17.15, 94: 17.38, 96: 2.8}.items()}
WATER = {'H1': 0.04744, 'O16': 0.02372}

def relative_std(tally: openmc.Tally, **selection) -> np.ndarray:
    mean = tally.get_values(**selection).ravel()
    std = tally.get_values(value='std_dev', **selection).ravel()
    return np.divide(std, mean, out=np.zeros_like(mean), where=mean > 0)[::-1]

def write_fuel_xs(statepoint: Path, path: Path, densities: dict[str, float]) -> None:
    with openmc.StatePoint(statepoint) as sp:
        k = sp.keff
        xs = effective_xs(sp, 'fuel', densities, SCORES, lambda v: v.ravel()[::-1])
        rates = sp.get_tally(name='fuel')
        flux = sp.get_tally(name='fuel flux')
        balance = sp.get_tally(name='balance')
        nuclides = {}
        for nuclide, by in xs.items():
            nuclides[nuclide] = {score: value.tolist() for score, value in by.items()}
            for score in SCORES:
                rsd = relative_std(rates, scores=[STORED.get(score, score)], nuclides=[nuclide])
                nuclides[nuclide][f'{score}-rsd'] = rsd.tolist()
        data = {'format': 'xlc-fuel-xs', 'keff': [k.nominal_value, k.std_dev], 'flux': flux.get_values(scores=['flux']).ravel()[::-1].tolist(), 'flux-rsd': relative_std(flux, scores=['flux']).tolist(), **{score: float(balance.get_values(scores=[score]).ravel()[0]) for score in ['absorption', 'nu-fission']}, 'densities': densities, 'nuclides': nuclides}
    path.write_bytes(msgpack.packb(data))

def read_run(source: Path) -> dict:
    run = read_input(source, RUN_KEYS | {'effective-xs-groups'}, set())
    if run['problem'] not in FUEL:
        raise SystemExit(f"unknown problem {run['problem']}; expected one of {list(FUEL)}")
    run['cross-sections'] = input_path(source, run['cross-sections'])
    run['effective-xs-groups'] = input_path(source, run['effective-xs-groups'])
    return run

def model(source: Path, directory: Path) -> None:
    run = read_run(source)
    densities = FUEL[run['problem']]
    directory.mkdir(parents=True, exist_ok=True)
    fuel = material('fuel', densities, TEMPERATURE)
    clad = material('zirconium', ZIRCONIUM, TEMPERATURE)
    water = material('water', WATER, TEMPERATURE)
    water.add_s_alpha_beta('c_H_in_H2O')
    materials = openmc.Materials([fuel, clad, water])
    pellet, outer = (openmc.ZCylinder(r=PELLET), openmc.ZCylinder(r=CLAD_OUTER))
    box = openmc.model.RectangularPrism(PITCH, PITCH, boundary_type='reflective')
    geometry = openmc.Geometry([openmc.Cell(fill=fuel, region=-pellet), openmc.Cell(fill=clad, region=+pellet & -outer), openmc.Cell(fill=water, region=+outer & -box)])
    settings = eigenvalue_settings(run['particles'], run['batches'], run['inactive'], run['seed'], PITCH / 2)
    settings.temperature = {'method': 'nearest', 'tolerance': 1.0}
    filters = [openmc.MaterialFilter([fuel]), group_filter(run['effective-xs-groups'])]
    tallies = fuel_tallies('fuel', filters, list(densities), SCORES)
    balance = openmc.Tally(name='balance')
    balance.scores = ['absorption', 'nu-fission']
    tallies.append(balance)
    openmc.Model(geometry, materials, settings, openmc.Tallies(tallies)).export_to_model_xml(directory / 'model.xml')

def solve(source: Path, directory: Path, work: Path) -> None:
    run = read_run(source)
    work.mkdir(parents=True, exist_ok=True)
    os.environ['OPENMC_CROSS_SECTIONS'] = str(run['cross-sections'])
    openmc.run(threads=run['threads'], output=False, cwd=work, path_input=str((directory / 'model.xml').resolve()))

def extract(source: Path, work: Path, results: Path) -> None:
    run = read_run(source)
    results.mkdir(parents=True, exist_ok=True)
    statepoint = work / f"statepoint.{run['batches']}.h5"
    write_fuel_xs(statepoint, results / 'fuel-xs.msgpack', FUEL[run['problem']])
    with openmc.StatePoint(statepoint) as sp:
        write_k(results / 'k.json', run['problem'], sp.keff)
if __name__ == '__main__':
    model_run_extract(model, solve, extract, __doc__)
