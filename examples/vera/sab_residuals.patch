+        return p.clone();
+    }
+    let lerp = |y: &[f64], e: f64| {
+        let k = p.energy.partition_point(|&x| x <= e).clamp(1, p.energy.len() - 1) - 1;
+        let (x0, x1) = (p.energy[k], p.energy[k + 1]);
+        if x1 == x0 {
+            y[k + 1]
+        } else {
+            y[k] + (e - x0) / (x1 - x0) * (y[k + 1] - y[k])
+        }
+    };
+    let n = 400;
+    let mut out = Pointwise::default();
+    for i in 0..n {
+        let e = low * (cutoff / low).powf(i as f64 / n as f64);
+        let sigma: f64 = sab.group_integrals(groups, e).iter().sum();
+        let el = lerp(&p.elastic, e);
+        out.energy.push(e);
+        out.elastic.push(sigma);
+        out.total.push(lerp(&p.total, e) + sigma - el);
+        out.fission.push(lerp(&p.fission, e));
+        out.nu_fission.push(lerp(&p.nu_fission, e));
+    }
+    // cutoff の左の極限
+    let sigma: f64 = sab.group_integrals(groups, cutoff * (1.0 - 1e-12)).iter().sum();
+    let el = lerp(&p.elastic, cutoff);
+    out.energy.push(cutoff);
+    out.elastic.push(sigma);
+    out.total.push(lerp(&p.total, cutoff) + sigma - el);
+    out.fission.push(lerp(&p.fission, cutoff));
+    out.nu_fission.push(lerp(&p.nu_fission, cutoff));
+    // cutoff の右の極限と、それより上の元の点
+    out.energy.push(cutoff);
+    out.elastic.push(el);
+    out.total.push(lerp(&p.total, cutoff));
+    out.fission.push(lerp(&p.fission, cutoff));
+    out.nu_fission.push(lerp(&p.nu_fission, cutoff));
+    for (k, &e) in p.energy.iter().enumerate().filter(|&(_, &e)| e > cutoff) {
+        out.energy.push(e);
+        out.elastic.push(p.elastic[k]);
+        out.total.push(p.total[k]);
+        out.fission.push(p.fission[k]);
+        out.nu_fission.push(p.nu_fission[k]);
+    }
+    tracing::warn!("trial: S(α, β) pointwise elastic below {cutoff} eV");
+    out
+}
