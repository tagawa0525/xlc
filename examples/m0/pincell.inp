# M0 のピンセル: 3.1 wt% の UO2（10.4 g/cm3）と水（0.74 g/cm3）。被覆管は含めない。
# 個数密度は 1/(barn cm)。
library wims69.msgpack
output pincell.fg
few-group-bounds 1e7 0.625 1e-5
pitch 1.26
azimuthal 32
spacing 0.05
material fuel temperature 293.6 U-235 7.281430e-04 U-238 2.247284e-02 O-16 4.640196e-02
material water temperature 293.6 H-1 4.947415e-02 O-16 2.473708e-02
cell pin fuel 0.4096 3 water - 2
row pin
