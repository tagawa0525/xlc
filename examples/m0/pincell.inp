# M0 のピンセル: 3.1 wt% の UO2（10.4 g/cm3）と水（0.74 g/cm3）。被覆管は含めない。
# 個数密度は 1/(barn cm)。
library wims69.lib
output pincell.fg
pitch 1.26
fuel-radius 0.4096
fuel-rings 3
moderator-rings 1
azimuthal 32
spacing 0.05
fuel U235 7.281430e-04 U238 2.247284e-02 O16 4.640196e-02
moderator H1 4.947415e-02 O16 2.473708e-02
few-group-bounds 1e7 0.625 1e-5
